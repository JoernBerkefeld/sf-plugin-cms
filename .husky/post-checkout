#!/bin/sh
set -eu
node scripts/check-temporary.mjs
# A fresh clone or worktree passes the all-zero SHA as $1: there is no previous lockfile to diff.
if [ "$3" = "1" ] && [ "$1" != "0000000000000000000000000000000000000000" ] && ! git diff --quiet "$1" "$2" -- package-lock.json; then
  npm install --no-workspaces
fi
